# 小新工坊部署配置示例
# 复制为 .env 后再填写真实值。不要提交 .env。

APP_NAME=小新工坊
APP_VERSION=1.5.7
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
TZ=Asia/Shanghai

# PostgreSQL
POSTGRES_DB=xiaoxin_workshop
POSTGRES_USER=xiaoxin
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432

# 本地账号登录。首次部署后请立即修改默认密码。
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=replace-with-a-strong-password
LOCAL_AUTH_DISPLAY_NAME=本地管理员

# 会话
SESSION_EXPIRE_MINUTES=120
SESSION_REFRESH_THRESHOLD_MINUTES=30
SESSION_COOKIE_SECURE=false
SESSION_SECRET_KEY=replace-with-a-long-random-secret

# AI 服务（至少配置一个）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=32000

# 本地模型或内网 AI 服务默认关闭。仅在受信任网络中按需开启。
ALLOW_PRIVATE_AI_ENDPOINTS=false
ALLOWED_AI_HOSTS=

# 邮件验证码（可选）
EMAIL_AUTH_ENABLED=false
EMAIL_LOGIN_ENABLED=false
EMAIL_REGISTER_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=小新工坊

# 网络代理（可选）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
